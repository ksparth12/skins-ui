{
  "$schema": "../../packages/checks/schema/component.schema.json",
  "name": "switch",
  "title": "Switch",
  "description": "Turns one setting on or off, right away.",
  "export": "Switch",
  "children": {
    "control": "none",
    "label": "",
    "default": ""
  },
  "props": [
    {
      "name": "label",
      "type": "string",
      "demo": "Email updates",
      "description": "The visible name of the setting."
    },
    {
      "name": "defaultChecked",
      "type": "boolean",
      "default": false,
      "demo": true,
      "description": "On when it first renders."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "Dims it and blocks interaction."
    },
    {
      "name": "size",
      "type": "enum",
      "options": [
        "sm",
        "md"
      ],
      "default": "md",
      "description": "20 or 24 pixels tall."
    }
  ],
  "states": [
    "off",
    "on",
    "focus",
    "disabled"
  ]
}
