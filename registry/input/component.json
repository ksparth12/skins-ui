{
  "$schema": "../../packages/checks/schema/component.schema.json",
  "name": "input",
  "title": "Input",
  "description": "One line of text, with its label, a hint and an error.",
  "export": "Input",
  "children": {
    "control": "none",
    "label": "",
    "default": ""
  },
  "props": [
    {
      "name": "label",
      "type": "string",
      "demo": "Email",
      "description": "The visible name."
    },
    {
      "name": "placeholder",
      "type": "string",
      "demo": "you@example.com",
      "description": "Shown while the field is empty."
    },
    {
      "name": "description",
      "type": "string",
      "demo": "We only use it to send your receipts.",
      "description": "The supporting line under the title."
    },
    {
      "name": "error",
      "type": "string",
      "demo": "",
      "description": "Shown instead of the description, and marks the field invalid."
    },
    {
      "name": "size",
      "type": "enum",
      "options": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md",
      "description": "32, 40 or 48 pixels tall."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "Dims it and blocks interaction."
    }
  ],
  "states": [
    "rest",
    "hover",
    "focus",
    "filled",
    "invalid",
    "disabled"
  ],
  "preview": {
    "height": 300
  }
}
