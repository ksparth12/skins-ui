{
  "$schema": "../../packages/checks/schema/component.schema.json",
  "name": "tooltip",
  "title": "Tooltip",
  "description": "A short label for a control, shown on hover or keyboard focus.",
  "export": "Tooltip",
  "children": {
    "control": "trigger",
    "label": "Trigger",
    "default": "Hover me"
  },
  "props": [
    {
      "name": "content",
      "type": "string",
      "demo": "Copy link",
      "description": "The text inside the tooltip."
    },
    {
      "name": "side",
      "type": "enum",
      "options": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "default": "top",
      "description": "Which side of the trigger it opens on."
    },
    {
      "name": "defaultOpen",
      "type": "boolean",
      "default": false,
      "demo": true,
      "description": "Open when it first renders."
    }
  ],
  "states": [
    "closed",
    "open"
  ],
  "preview": {
    "height": 300
  }
}
